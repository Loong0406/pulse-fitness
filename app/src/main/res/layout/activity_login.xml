<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_surface">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/auth_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/auth_hero"
            android:focusableInTouchMode="true">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="264dp">
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="120dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginBottom="24dp"
                    android:alpha="0.12"
                    android:src="@drawable/auth_pulse"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="32dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_launcher"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/auth_brand"
                            android:textColor="@color/auth_on_hero"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/auth_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/auth_headline"
                        android:textSize="36sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/auth_on_hero"
                        android:lineSpacingExtra="2dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/auth_tagline"
                        android:textColor="@color/auth_hero_secondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_auth_sheet"
                android:padding="24dp">
                <TextView
                    android:id="@+id/auth_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/auth_title"
                    android:textColor="@color/auth_on_surface"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auth_subtitle"
                    android:textColor="@color/auth_secondary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/auth_demo_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/auth_demo_notice"
                    android:textColor="@color/auth_action"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
                <CheckBox
                    android:id="@+id/auth_use_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/auth_use_server"
                    android:textColor="@color/auth_on_surface"
                    android:buttonTint="@color/auth_action" />
                <Button
                    android:id="@+id/auth_connection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/auth_connection"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="@color/auth_action" />
                <TextView
                    style="@style/AuthLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/auth_phone_label" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_auth_field"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/auth_country_code"
                        android:textColor="@color/auth_on_surface"
                        android:textSize="16sp" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="@color/auth_outline" />
                    <EditText
                        android:id="@+id/auth_phone"
                        style="@style/AuthInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="@string/auth_phone_hint"
                        android:maxLength="11"
                        android:inputType="phone"
                        android:autofillHints="phoneNational"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@id/auth_code" />
                </LinearLayout>
                <TextView
                    style="@style/AuthLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/auth_code_label" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_auth_field"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <EditText
                        android:id="@+id/auth_code"
                        style="@style/AuthInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="@string/auth_code_hint"
                        android:maxLength="6"
                        android:inputType="number"
                        android:autofillHints="smsOTPCode"
                        android:imeOptions="actionDone" />
                    <Button
                        android:id="@+id/auth_get_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="108dp"
                        android:minHeight="48dp"
                        android:layout_margin="4dp"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/bg_auth_code"
                        android:text="@string/auth_get_code"
                        android:textColor="@color/auth_code_text"
                        android:textSize="13sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/auth_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/auth_error"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"
                    android:accessibilityLiveRegion="polite" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">
                    <CheckBox
                        android:id="@+id/auth_agree"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:buttonTint="@color/auth_action"
                        android:text="@string/auth_agreement"
                        android:textSize="13sp"
                        android:textColor="@color/auth_secondary" />
                    <TextView
                        android:id="@+id/auth_terms"
                        style="@style/AuthLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_terms" />
                    <TextView
                        android:id="@+id/auth_privacy"
                        style="@style/AuthLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/auth_privacy" />
                </LinearLayout>
                <Button
                    android:id="@+id/auth_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="14dp"
                    android:text="@string/auth_login"
                    android:textColor="@color/auth_on_primary" />
                <Button
                    android:id="@+id/auth_guest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginTop="10dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="@string/auth_guest"
                    android:textColor="@color/auth_action"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/auth_local_data"
                    android:textColor="@color/auth_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
